{
  "name": "sugarcommerce/rate-limit",
  "version": "1.0.0",
  "description": "Sliding-window rate limiting with atomic counters. APCu, file and in-memory stores, standard rate-limit headers, and an API that makes forgetting the identity key impossible. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/rate-limit",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["rate-limit", "throttle", "sliding-window", "apcu", "429", "brute-force"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "suggest": { "ext-apcu": "Shared-memory counters — the right store for a single server." },
  "autoload": { "psr-4": { "Sugar\\RateLimit\\": "src/" } },
  "autoload-dev": { "psr-4": { "Sugar\\RateLimit\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/rate-limit/issues",
    "source": "https://github.com/sugarcommerce/rate-limit"
  }
}
